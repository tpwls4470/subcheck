{
  "manifest_version": 3,
  "name": "subcheck 사용량 수집 실험",
  "version": "0.3.0",
  "description": "표시된 Codex·Work 공유 사용량을 기록하고 동의 시 로그인한 서브체크 계정으로 동기화합니다.",
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/settings/usage*"
      ],
      "js": [
        "parser.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://subcheck-mobile-tpwls4470.satinyshark14.chatgpt.site/*"
      ],
      "js": [
        "bridge.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    },
    {
      "matches": [
        "https://kling.ai/app/membership/membership-plan*"
      ],
      "js": [
        "kling-billing.js"
      ],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "https://subcheck-mobile-tpwls4470.satinyshark14.chatgpt.site/*"
  ]
}