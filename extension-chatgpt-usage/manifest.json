{
  "manifest_version": 3,
  "name": "subcheck 사용량 수집 실험",
  "version": "0.1.0",
  "description": "ChatGPT 설정에 표시된 Codex·Work 공유 사용량을 이 브라우저에만 기록하는 검증용 확장 프로그램입니다.",
  "permissions": ["storage"],
  "content_scripts": [{"matches": ["https://chatgpt.com/settings/usage*"], "js": ["parser.js", "content.js"], "run_at": "document_idle", "world": "ISOLATED"}],
  "action": {"default_popup": "popup.html"}
}
